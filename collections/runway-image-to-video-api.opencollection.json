{
  "opencollection": "1.0.0",
  "info": {
    "name": "Runway Characters Avatars Image to Video API",
    "version": "2024-11-06"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Image to Video",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create image-to-video generation task",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.dev.runwayml.com/v1/image_to_video",
            "headers": [
              {
                "name": "X-Runway-Version",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Starts a new asynchronous task to generate a video from an input image. Optionally accepts a text prompt to guide the generation. Supports Gen-4, Gen-4 Turbo, Gen-4.5, and Aleph models. Returns a task ID that can be polled for completion."
        }
      ]
    }
  ],
  "bundled": true
}