      "id": "88421d2c-e003-4ccd-9006-e24fb23d606a",
      "name": "Realtime Sessions",
      "description": {
        "content": "Create live WebRTC sessions connecting users to avatars for real-time conversational interactions. Each session has a maximum duration of 5 minutes.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "52718186-6f61-4126-a563-c82c3e3bc671",
          "name": "Create a new realtime session",
          "request": {
            "name": "Create a new realtime session",
            "description": {
              "content": "Creates a new realtime WebRTC session connecting a user to an avatar for a live conversational interaction. The session returns WebRTC credentials (server URL, token, and room name) that can only be retrieved once. If the WebRTC connection fails after credentials are consumed, a new session must be created. Sessions have a maximum duration of 5 minutes.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "realtime_sessions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
