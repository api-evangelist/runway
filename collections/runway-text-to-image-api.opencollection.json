{
  "opencollection": "1.0.0",
  "info": {
    "name": "Runway Characters Avatars Text to Image API",
    "version": "2024-11-06"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Text to Image",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create text-to-image generation task",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.dev.runwayml.com/v1/text_to_image",
            "headers": [
              {
                "name": "X-Runway-Version",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Starts a new asynchronous task to generate an image from a text prompt using the Gen-4 Image model. The prompt describes what should appear in the generated image. Returns a task ID that can be polled for completion."
        }
      ]
    }
  ],
  "bundled": true
}