          "name": "Create text-to-image generation task",
          "request": {
            "name": "Create text-to-image generation task",
            "description": {
              "content": "Starts a new asynchronous task to generate an image from a text prompt using the Gen-4 Image model. The prompt describes what should appear in the generated image. Returns a task ID that can be polled for completion.",
              "type": "text/plain"
            },
