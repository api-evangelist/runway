          "name": "Retrieve task status and output",
          "request": {
            "name": "Retrieve task status and output",
            "description": {
              "content": "Retrieves the current status and output of an asynchronous image generation task by its unique identifier. Poll this endpoint until the task status indicates completion. When a task succeeds, the response includes output URLs linking to the generated image.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "tasks",
                ":id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "id",
                  "description": "(Required) The unique identifier of the task, returned when the task was created."
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) API version identifier. Must be set to the exact value 2024-11-06.",
                "key": "X-Runway-Version",
                "value": "<string>"
