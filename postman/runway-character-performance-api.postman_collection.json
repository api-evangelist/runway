      "item": [
        {
          "name": "Create character performance (Act Two) task",
          "id": "e9e1d04f-f3b3-4c64-8736-8db106a6d7ea",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "description": "(Required) API version identifier. Must be set to the exact value 2024-11-06.",
                "key": "X-Runway-Version",
                "value": "2024-11-06"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"act_two\",\n  \"character\": {\n    \"type\": \"video\",\n    \"uri\": \"<string>\"\n  },\n  \"reference\": {\n    \"type\": \"video\",\n    \"uri\": \"<string>\"\n  },\n  \"ratio\": \"1104:832\"\n}",
              "options": {
                "raw": {
                  "headerFamily": "json",
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/character_performance",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "character_performance"
              ]
            },
            "description": "Starts a new asynchronous task to control a character's facial expressions and body movements using a reference performance video. Uses the Act Two model to animate a character image or video based on a driving reference. Returns a task ID that can be polled for completion."
