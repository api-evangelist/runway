      "item": [
        {
          "name": "Create lip sync generation task",
          "id": "7f718b2f-72fe-4ee2-8d78-592df678be29",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "description": "(Required) API version identifier. Must be set to the exact value 2024-11-06.",
                "key": "X-Runway-Version",
                "value": "2024-11-06"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"gen4\",\n  \"input\": \"<string>\",\n  \"audio\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "headerFamily": "json",
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/lip_sync",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "lip_sync"
              ]
            },
            "description": "Starts a new asynchronous task to create a generative video where a selected face speaks lines from audio clips or AI-generated voices. Supports 28+ languages using the eleven_multilingual_v2 model. Returns a task ID that can be polled for completion."
