          "item": [
            {
              "name": "Retrieve task status and output",
              "id": "d57e7d13-d88c-4723-94fc-18e366fc7b02",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "description": "(Required) API version identifier. Must be set to the exact value 2024-11-06.",
                    "key": "X-Runway-Version",
                    "value": "2024-11-06"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/tasks/:id",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "tasks",
                    ":id"
                  ],
                  "variable": [
                    {
                      "id": "31e373a4-7d00-400c-b939-d2f26a2ed534",
                      "key": "id",
                      "value": "<uuid>",
                      "description": "(Required) The unique identifier of the task, returned when the task was created."
                    }
                  ]
                },
                "description": "Retrieves the current status and output of an asynchronous image generation task by its unique identifier. Poll this endpoint until the task status indicates completion. When a task succeeds, the response includes output URLs linking to the generated image."
              },
              "response": [
                {
