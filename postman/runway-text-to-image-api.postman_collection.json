      "name": "text_to_image",
      "item": [
        {
          "name": "Create text-to-image generation task",
          "id": "a26392b7-86dd-47cd-b895-4f46270a56ce",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "description": "(Required) API version identifier. Must be set to the exact value 2024-11-06.",
                "key": "X-Runway-Version",
                "value": "2024-11-06"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"gen4_image\",\n  \"promptText\": \"<string>\",\n  \"ratio\": \"1280:720\"\n}",
              "options": {
                "raw": {
                  "headerFamily": "json",
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/text_to_image",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "text_to_image"
              ]
            },
            "description": "Starts a new asynchronous task to generate an image from a text prompt using the Gen-4 Image model. The prompt describes what should appear in the generated image. Returns a task ID that can be polled for completion."
          },
