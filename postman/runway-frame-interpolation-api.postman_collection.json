          "id": "1e9ae6b3-97f1-4bc9-b23e-f7d3ae8b6bfe",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "description": "(Required) API version identifier. Must be set to the exact value 2024-11-06.",
                "key": "X-Runway-Version",
                "value": "2024-11-06"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"frame_interpolation_v1\",\n  \"videoUri\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "headerFamily": "json",
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/frame_interpolation",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "frame_interpolation"
              ]
            },
            "description": "Starts a new asynchronous task to interpolate between video frames, increasing the frame rate and smoothness of the output video. Returns a task ID that can be polled for completion."
