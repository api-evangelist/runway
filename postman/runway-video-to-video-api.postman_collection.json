      "name": "video_to_video",
      "item": [
        {
          "name": "Create video-to-video generation task",
          "id": "89266641-b8be-4dfd-8477-eda00dcb040f",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "description": "(Required) API version identifier. Must be set to the exact value 2024-11-06.",
                "key": "X-Runway-Version",
                "value": "2024-11-06"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"gen4_aleph\",\n  \"promptVideo\": \"<string>\",\n  \"promptText\": \"<string>\",\n  \"ratio\": \"1584:672\"\n}",
              "options": {
                "raw": {
                  "headerFamily": "json",
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/video_to_video",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "video_to_video"
              ]
            },
            "description": "Starts a new asynchronous task to generate a video from an existing video input using the Gen-4 Aleph model. The input video serves as a reference for the generation, with a text prompt guiding the transformation. Returns a task ID that can be polled for completion."
