      "name": "text_to_video",
      "item": [
        {
          "name": "Create text-to-video generation task",
          "id": "3797b1b5-0779-447d-9423-86be847edd5c",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "description": "(Required) API version identifier. Must be set to the exact value 2024-11-06.",
                "key": "X-Runway-Version",
                "value": "2024-11-06"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"gen4.5\",\n  \"promptText\": \"<string>\",\n  \"duration\": 10,\n  \"ratio\": \"832:1104\"\n}",
              "options": {
                "raw": {
                  "headerFamily": "json",
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/text_to_video",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "text_to_video"
              ]
            },
            "description": "Starts a new asynchronous task to generate a video from a text prompt alone, without requiring an input image. Supported by Gen-4.5, Veo 3.1, and Veo 3.1 Fast models. Returns a task ID that can be polled for completion."
