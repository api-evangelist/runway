                    "value": "application/json"
                  },
                  {
                    "description": "Added as a part of security scheme: bearer",
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"model\": \"gwm1_avatars\",\n  \"avatar\": {\n    \"type\": \"preset\",\n    \"presetId\": \"fashion-designer\"\n  },\n  \"maxSessionDurationSeconds\": \"<integer>\",\n  \"personality\": \"<string>\",\n  \"startScript\": \"<string>\"\n}",
                  "options": {
                    "raw": {
                      "headerFamily": "json",
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/realtime_sessions",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "realtime_sessions"
                  ]
                }
